@inherits LayoutComponentBase
@using MudBlazor

<MudThemeProvider Theme="_theme" IsDarkMode="@_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudMainContent Style="padding-top: 12px;">

        <MudStack Row="true"
                  Justify="Justify.FlexEnd"
                  AlignItems="AlignItems.Center"
                  Class="pr-6">

            <MudText Typo="Typo.caption" Class="@_textClass">
                @(_isDarkMode ? "Dark Mode" : "Light Mode")
            </MudText>

            <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.DarkMode : Icons.Material.Filled.LightMode)"
                           Color="@(_isDarkMode ? Color.Warning : Color.Primary)"
                           OnClick="ToggleTheme" />

        </MudStack>
        <CascadingValue Value="_isDarkMode">
            @Body
        </CascadingValue>
    </MudMainContent>
</MudLayout>

@code {
    private bool _isDarkMode = true;
    private string _textClass = "theme-label";

    private async Task ToggleTheme()
    {
        _textClass = "theme-label theme-label-changing";
        StateHasChanged();

        await Task.Delay(150);

        _isDarkMode = !_isDarkMode;

        _textClass = "theme-label";
        StateHasChanged();
    }

    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Background = "#f5f5f5",
            Surface = "#ffffff",
            Primary = "#6366f1",
            Secondary = "#ec4899",
            TextPrimary = "#1a1a1a"
        },
        PaletteDark = new PaletteDark
        {
            Background = "#0f172a",
            Surface = "#141f38",
            Primary = "#6366f1",
            Secondary = "#ec4899",
            TextPrimary = "#ffffff"
        }
    };
}