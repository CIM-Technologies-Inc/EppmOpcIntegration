    private async Task OnProjectChanged(string projectId)
    {
        selectedProjectObjectId = projectId;
        receiverEmail = "";
        showEmailValidation = false;

        if (string.IsNullOrEmpty(projectId))
            return;

        using var db = new AppDbContext();

        var schedule = await db.ScheduleSettings
            .Where(s => s.Project == projectId)
            .OrderByDescending(s => s.Id)
            .FirstOrDefaultAsync();

        if (schedule == null)
        {
            SelectScheduleType("Never");
            selectedDays.Clear();
            selectedTime = null;
            selectedDate = DateTime.Now;

            Snackbar.Add("No saved schedule for this project.", Severity.Info);
            ShowDays = false;
            ShowStatus = false;
            nextRun = GetNextRun(schedule);
            return;
        }

        selectedScheduleType = schedule.ScheduleType ?? "Never";
        selectedTime = schedule.Time;
        selectedDate = schedule.DateTimePublish;
        selectedDays = string.IsNullOrEmpty(schedule.Days)
            ? new List<string>()
            : schedule.Days.Split(',', StringSplitOptions.RemoveEmptyEntries).ToList();
        schedType = schedule.ScheduleType ?? "Never";
        // ShowDays = selectedScheduleType == "Weekly" || selectedScheduleType == "Custom";
        ShowDays = selectedScheduleType == "Weekly";

        StatusMessage = "Loaded project schedule.";
        StatusSeverity = Severity.Info;
        ShowStatus = true;

        nextRun = GetNextRun(schedule);
        StateHasChanged();
    }

    private DateTime? GetNextRun(ScheduleSetting schedule)
    {
        if (schedule == null)
            return null;

        var now = DateTime.Now;

        switch (schedule.ScheduleType)
        {
            case "Daily":
                {
                    var next = now.Date + schedule.Time;

                    // if today's time already passed, move to tomorrow
                    if (next <= now)
                        next = next.AddDays(1);

                    return next;
                }

            case "Weekly":
                {
                    if (string.IsNullOrWhiteSpace(schedule.Days))
                        return null;

                    var days = schedule.Days
                        .Split(',', StringSplitOptions.RemoveEmptyEntries)
                        .Select(d => d.Trim())
                        .ToList();

                    var dayMap = new Dictionary<string, DayOfWeek>(StringComparer.OrdinalIgnoreCase)
                    {
                        ["Mon"] = DayOfWeek.Monday,
                        ["Monday"] = DayOfWeek.Monday,

                        ["Tue"] = DayOfWeek.Tuesday,
                        ["Tuesday"] = DayOfWeek.Tuesday,

                        ["Wed"] = DayOfWeek.Wednesday,
                        ["Wednesday"] = DayOfWeek.Wednesday,

                        ["Thu"] = DayOfWeek.Thursday,
                        ["Thursday"] = DayOfWeek.Thursday,

                        ["Fri"] = DayOfWeek.Friday,
                        ["Friday"] = DayOfWeek.Friday,

                        ["Sat"] = DayOfWeek.Saturday,
                        ["Saturday"] = DayOfWeek.Saturday,

                        ["Sun"] = DayOfWeek.Sunday,
                        ["Sunday"] = DayOfWeek.Sunday
                    };

                    var validDays = days
                        .Where(d => dayMap.ContainsKey(d))
                        .Select(d => dayMap[d])
                        .ToHashSet();

                    DateTime? nextRun = null;

                    for (int i = 0; i < 14; i++) // IMPORTANT: 14 days ensures full cycle safety
                    {
                        var candidateDate = now.Date.AddDays(i);

                        if (!validDays.Contains(candidateDate.DayOfWeek))
                            continue;

                        var candidate = candidateDate.Add(schedule.Time);

                        // accept ONLY future runs
                        if (candidate > now)
                        {
                            nextRun = candidate;
                            break;
                        }
                    }

                    return nextRun;
                }

            case "Custom":
                {
                    if (schedule.DateTimePublish > now)
                        return schedule.DateTimePublish;

                    return null; 
                }

            default:
                return null;
        }
    }
