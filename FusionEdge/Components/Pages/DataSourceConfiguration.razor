@page "/DataSourceConfiguration"
@using MudBlazor
@using FusionEdge.Components.Services
@using FusionEdge.Data.DTOs
@inject IAuthenticationService AuthenticationService
@inject NavigationManager Navigation
@inject ISourceConfigurationService SourceConfigurationService
@inject SessionService Session
@inject ISnackbar Snackbar

@if (isPageLoading) {
    <MudPaper Class="pa-6 mx-auto"
              Style="background-color:#1e1e2e; color:#e0e0e0; max-width:500px; border-radius:16px;">

        <MudStack Spacing="4">

            <!-- Header -->
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <MudSkeleton SkeletonType="SkeletonType.Rectangle"
                             Width="40px"
                             Height="40px" />

                <MudSkeleton SkeletonType="SkeletonType.Text"
                             Width="220px"
                             Height="40px" />

                <MudSkeleton SkeletonType="SkeletonType.Rectangle"
                             Width="40px"
                             Height="40px" />
            </MudStack>

            <!-- Description -->
            <MudSkeleton SkeletonType="SkeletonType.Text"
                         Width="100%"
                         Height="20px" />

            <!-- Source Cards -->
            <MudStack Row="true" Spacing="3">
                <MudSkeleton SkeletonType="SkeletonType.Rectangle"
                             Width="100%"
                             Height="90px" />

                <MudSkeleton SkeletonType="SkeletonType.Rectangle"
                             Width="100%"
                             Height="90px" />
            </MudStack>

            <!-- Domain -->
            <MudSkeleton SkeletonType="SkeletonType.Rectangle"
                         Width="100%"
                         Height="56px" />

            <!-- Username -->
            <MudSkeleton SkeletonType="SkeletonType.Rectangle"
                         Width="100%"
                         Height="56px" />

            <!-- Password -->
            <MudSkeleton SkeletonType="SkeletonType.Rectangle"
                         Width="100%"
                         Height="56px" />

            <!-- Buttons -->
            <MudStack Row="true" Spacing="2">
                <MudSkeleton SkeletonType="SkeletonType.Rectangle"
                             Width="100%"
                             Height="48px" />

                <MudSkeleton SkeletonType="SkeletonType.Rectangle"
                             Width="100%"
                             Height="48px" />
            </MudStack>

        </MudStack>

    </MudPaper>
}
else {
    <MudPaper Class="pa-6 mx-auto"
    Style="background-color:#1e1e2e; color:#e0e0e0; max-width:500px; border-radius:16px;">
        <MudStack Spacing="4">

            <!-- Header -->
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Justify="Justify.SpaceBetween">
                <MudIcon Icon="@Icons.Material.Filled.SettingsInputComponent" Color="Color.Primary" />
                <MudText Typo="Typo.h6" Style="color:white; font-weight:500;">
                    Data Source Configuration
                </MudText>
                <MudTooltip Text="Back" Arrow="true" Placement="Placement.Top" Color="Color.Primary" Typo="Typo.button">
                    <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                    Color="Color.Default"
                    OnClick="GoBackToPublish"
                    AriaLabel="Back" />
                </MudTooltip>
            </MudStack>

            <MudText Typo="Typo.body2" Style="color:#b0b0b0;">
                Choose your data source and enter the credentials used to connect.
            </MudText>

            <!-- ── SOURCE TOGGLE ── -->
            <MudStack Spacing="2">
                <MudText Typo="Typo.body2" Style="color:#e0e0e0;">Data Source</MudText>
                <MudStack Row="true" Spacing="3">
                    <MudPaper Class="pa-4 d-flex flex-column align-center justify-center flex-grow-1 source-card"
                    Style="@GetSourceStyle("EPPM")"
                    @onclick="@(() => SelectSource("EPPM"))">
                        <MudIcon Icon="@Icons.Material.Filled.Storage"
                        Size="Size.Medium"
                        Style="color:#e0e0e0;" />
                        <MudText Typo="Typo.body2" Class="mt-2" Style="color:#e0e0e0;">
                            On-Premises (EPPM)
                        </MudText>
                    </MudPaper>
                    <MudPaper Class="pa-4 d-flex flex-column align-center justify-center flex-grow-1 source-card"
                    Style="@GetSourceStyle("OPC")"
                    @onclick="@(() => SelectSource("OPC"))">
                        <MudIcon Icon="@Icons.Material.Filled.Cloud"
                        Size="Size.Medium"
                        Style="color:#e0e0e0;" />
                        <MudText Typo="Typo.body2" Class="mt-2" Style="color:#e0e0e0;">
                            Oracle Cloud (OPC)
                        </MudText>
                    </MudPaper>
                </MudStack>
            </MudStack>

            <!-- ── EPPM DOMAIN (only for EPPM) ── -->
            @if (selectedSource == "EPPM")
            {
                <MudTextField T="string"
                Label="Domain / Server URL"
                Variant="Variant.Outlined"
                Margin="Margin.Dense"
                @bind-Value="domain"
                Placeholder="https://your-eppm-server.com"
                Adornment="Adornment.Start"
                AdornmentIcon="@Icons.Material.Filled.Language"
                Style="background-color:#2a2a3a; border-radius:4px;" />
            }

            <!-- ── CREDENTIALS ── -->
            <MudTextField T="string"
            Label="Username"
            Variant="Variant.Outlined"
            Margin="Margin.Dense"
            @bind-Value="username"
            Adornment="Adornment.Start"
            AdornmentIcon="@Icons.Material.Filled.Person"
            Style="background-color:#2a2a3a; border-radius:4px;" />

            <MudTextField T="string"
            Label="Password"
            Variant="Variant.Outlined"
            Margin="Margin.Dense"
            @bind-Value="password"
            InputType="@passwordInputType"
            Adornment="Adornment.End"
            AdornmentIcon="@passwordEyeIcon"
            OnAdornmentClick="TogglePassword"
            AdornmentAriaLabel="Toggle password visibility"
            Style="background-color:#2a2a3a; border-radius:4px;" />

            <!-- ── STATUS ── -->
            @if (!string.IsNullOrWhiteSpace(statusMessage))
            {
                <MudAlert Severity="@statusSeverity"
                Variant="Variant.Filled"
                Dense="true"
                ShowCloseIcon="true"
                CloseIconClicked="CloseAlert">
                    @statusMessage
                </MudAlert>
            }

            <!-- ── ACTIONS ── -->
            <MudStack Row="true" Spacing="2" Class="mt-2">
                <MudButton Variant="Variant.Filled"
                Color="Color.Primary"
                FullWidth
                Size="Size.Large"
                Disabled="isSaving"
                OnClick="SaveConfiguration">
                    @if (isSaving)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        <span>Saving...</span>
                    }
                    else
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Save" Class="mr-2" />
                        <span>Save Configuration</span>
                    }
                </MudButton>

                <MudButton Variant="Variant.Outlined"
                Color="Color.Info"
                FullWidth
                Size="Size.Large"
                Disabled="isTesting"
                OnClick="TestConnection">
                    @if (isTesting)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        <span>Testing...</span>
                    }
                    else
                    {
                        <MudIcon Icon="@Icons.Material.Filled.NetworkCheck" Class="mr-2" />
                        <span>Test Connection</span>
                    }
                </MudButton>
            </MudStack>

        </MudStack>
    </MudPaper>
}

@code {

    private readonly string _opcUsername = "demo@projectpro-ph.com";
    private readonly string _eppmUrl = "http://192.168.8.128:8206";
    private readonly string _eppmUsername = "cimadmin1";
    // private string selectedSource = "OPC";
    private string selectedSource = string.Empty;
    private string domain = string.Empty;
    private string username = string.Empty;
    private string password = string.Empty;
    private bool showPassword = false;
    private bool isSaving = false;
    private bool isTesting = false;
    private bool isPageLoading = true;
    private string statusMessage = string.Empty;
    private Severity statusSeverity = Severity.Info;

    protected override async Task OnInitializedAsync()
    {
        await LoadConfiguration();
    }

    private void GoBackToPublish()
    {
        Navigation.NavigateTo("/Publish");
    }

    private void CloseAlert()
    {
        statusMessage = string.Empty;
    }

    private async Task LoadConfiguration()
    {
        try
        {
            // var userId = Preferences.Get("logged_in_user_id", 0);
            isPageLoading = true;
            var userId = Session.UserId;

            if (userId == 0)
            {
                Navigation.NavigateTo("/Publish");
                return;
            }
            var config = await SourceConfigurationService.GetSingleSourceConfiguration(userId);

            if (config != null)
            {
                selectedSource = config.SelectedSource;
                domain = config.Domain;
                username = config.Username;
                // ✅ never populate password from hash — leave blank for security
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"Error loading configuration: {ex.Message}";
            statusSeverity = Severity.Error;
        }
        finally
        {
            await Task.Delay(500);
            isPageLoading = false;
        }
    }

    // ── PASSWORD TOGGLE ──
    private InputType passwordInputType => showPassword
        ? InputType.Text
        : InputType.Password;

    private string passwordEyeIcon => showPassword
        ? Icons.Material.Filled.VisibilityOff
        : Icons.Material.Filled.Visibility;

    private void TogglePassword() => showPassword = !showPassword;

    // ── SOURCE SELECTION ──
    private void SelectSource(string source)
    {
        // if (selectedSource == source) return;
        // selectedSource = source;
        // domain = string.Empty;
        // username = string.Empty;
        // password = string.Empty;
        // statusMessage = string.Empty;
        // StateHasChanged();

        if (selectedSource == source) return;

        selectedSource = source;

        domain = selectedSource != "OPC" ? _eppmUrl : string.Empty;
        password = string.Empty;
        username = selectedSource == "OPC" ? _opcUsername: _eppmUsername;

        statusMessage = string.Empty;

        StateHasChanged();
    }

    private string GetSourceStyle(string source)
    {
        var baseStyle =
        "background-color:#2a2a3a;" +
        "cursor:pointer;" +
        "min-height:80px;" +
        "border-radius:8px;" +
        "transition:all 0.2s ease;";

        if (string.IsNullOrEmpty(selectedSource))
        {
            return baseStyle;
        }

        return selectedSource == source
            ? baseStyle + "border:2px solid #1976d2; background-color:#2d3f5f;"
            : baseStyle;
    }

    // ── VALIDATE ──
    private bool Validate()
    {
        if (string.IsNullOrWhiteSpace(selectedSource))
        {
            statusMessage = "Please select data source.";
            statusSeverity = Severity.Warning;
            return false;
        }

        if (selectedSource == "EPPM" && string.IsNullOrWhiteSpace(domain))
        {
            statusMessage = "Please enter the domain / server URL.";
            statusSeverity = Severity.Warning;
            return false;
        }
        if (string.IsNullOrWhiteSpace(username))
        {
            statusMessage = "Username is required.";
            statusSeverity = Severity.Warning;
            return false;
        }
        if (string.IsNullOrWhiteSpace(password))
        {
            statusMessage = "Password is required.";
            statusSeverity = Severity.Warning;
            return false;
        }
        return true;
    }

    // ── SAVE ──
    private async Task SaveConfiguration()
    {
        statusMessage = string.Empty;
        // var userId = Preferences.Get("logged_in_user_id", 0);
        var userId = Session.UserId;

        if (!Validate()) return;

        try
        {
            isSaving = true;

            var dto = new SourceSettingDto
            {
                UserId = userId,
                SelectedSource = selectedSource,
                Domain = selectedSource == "EPPM" ? domain : string.Empty,
                Username = username,
                PlainPass = password,
                Password = password
            };

            var res = await AuthenticationService.AuthenticateCredential(username, password);
        
            if (res)
            {
                var success = await AuthenticationService.SaveSourceConfiguration(dto);

                if (success)
                {
                    statusMessage = "Configuration saved successfully.";
                    statusSeverity = Severity.Success;

                    Snackbar.Add("Configuration saved successfully", Severity.Success);

                    await Task.Delay(800);
                    Navigation.NavigateTo("/Publish");
                }
                else
                {
                    statusMessage = "Failed to save configuration. Please try again.";
                    statusSeverity = Severity.Error;
                }
            } else
            {
                Snackbar.Add("Unable to connect to server with your credential", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"Error saving: {ex.Message}";
            statusSeverity = Severity.Error;
        }
        finally
        {
            isSaving = false;
        }
    }

    // ── TEST CONNECTION ──
    private async Task TestConnection()
    {
        statusMessage = string.Empty;
        if (!Validate()) return;

        try
        {
            isTesting = true;

            // var ok = true;

            // if (ok)
            // {
            //     statusMessage = "Connection successful!";
            //     statusSeverity = Severity.Success;
            // }
            // else
            // {
            //     statusMessage = "Connection failed. Check your credentials.";
            //     statusSeverity = Severity.Error;
            // }
            if (selectedSource == "EPPM")
            {
                var res = await AuthenticationService.AuthenticateCredential(username, password);

                if (res)
                {
                    Snackbar.Add("Successfully connected to the server", Severity.Success);
                    statusMessage = "Connected!";
                    statusSeverity = Severity.Success;
                } 
                else
                {
                    Snackbar.Add("Unable to connect to server...!", Severity.Error);
                    statusMessage = "Failed to connect...";
                    statusSeverity = Severity.Error;
                }
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"Connection failed: {ex.Message}";
            statusSeverity = Severity.Error;
        }
        finally
        {
            isTesting = false;
        }
    }
}

<style>
    .source-card {
        transition: all 0.2s ease;
        border: 1px solid #3a3a4a;
        background-color: #2a2a3a;
        cursor: pointer;
    }

    .source-card:hover {
        border: 2px solid #5a9cff;
        background-color: #32324a;
        transform: translateY(-2px);
    }
</style>